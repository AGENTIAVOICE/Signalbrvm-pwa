# Dépendances
node_modules/

# Sortie de build — reconstruite automatiquement par Netlify à chaque
# déploiement (npm run build), ne doit jamais être versionnée.
dist/
dist-ssr/

# Variables d'environnement locales (secrets) — ne jamais commiter.
.env
.env.local
.env.*.local

# Fichiers d'éditeur / système
.DS_Store
*.local
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
